@model RegisterVm
<h2>Create an account</h2>@if(ViewBag.Error!=null){<div class="alert alert-danger">@ViewBag.Error</div>}<form method="post" class="form-box"><label>First name</label><input class="form-control mb-2" asp-for="FirstName" required/><label>Last name</label><input class="form-control mb-2" asp-for="LastName" required/><label>Email</label><input class="form-control mb-2" asp-for="Email" type="email" required/><label>Password (minimum 8 characters)</label><input class="form-control mb-2" asp-for="Password" type="password" minlength="8" required/><label>Role</label><select class="form-select mb-2" asp-for="Role"><option>Participant</option><option>Organiser</option></select><label>Phone</label><input class="form-control mb-3" asp-for="Phone"/><button class="btn btn-warning">Register</button></form>