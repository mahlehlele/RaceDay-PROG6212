@model List<ResultVm>
<h2>My race results</h2><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.EventName</td><td>@r.EventDate.ToString("dd MMM yyyy")</td><td>@r.CategoryName</td><td>@(r.FinishTime?.ToString()??"Not recorded")</td><td>@(r.FinishingPosition?.ToString()??"Not recorded")</td></tr>}</tbody></table></div>