@model List<EventVm>
<h2>Upcoming events</h2><div class="row g-3">@foreach(var e in Model){<div class="col-md-6 col-lg-4"><div class="card h-100 shadow-sm"><div class="card-body"><span class="badge bg-warning text-dark">@e.EventType</span><h4 class="mt-2">@e.Name</h4><p>@e.Description</p><p><strong>@e.EventDate.ToString("dd MMM yyyy")</strong><br/>@e.Location<br/>@e.DistanceKm km</p><a class="btn btn-dark" asp-action="Details" asp-route-id="@e.EventId">View event</a></div></div></div>}</div>@if(Model.Count==0){<p>No events are currently available. Please check again later.</p>}