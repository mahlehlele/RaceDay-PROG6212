@model EventVm
<h2>@Model.Name</h2><p>@Model.Description</p><p><b>Date:</b> @Model.EventDate.ToString("dd MMM yyyy") | <b>Location:</b> @Model.Location | <b>Distance:</b> @Model.DistanceKm km | <b>Type:</b> @Model.EventType</p><h4>Available categories</h4>@foreach(var c in (List<CategoryVm>)ViewBag.Categories){<div class="border rounded p-3 mb-2"><b>@c.Name</b> — @c.Description @if(Context.Session.GetString("Role")=="Participant"){<form method="post" asp-action="Enter" class="mt-2"><input type="hidden" name="eventId" value="@Model.EventId"/><input type="hidden" name="categoryId" value="@c.CategoryId"/><button class="btn btn-warning btn-sm">Enter this event</button></form>}</div>}