<!DOCTYPE html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css"/></head><body><nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container"><a class="navbar-brand fw-bold" href="/">RACEDAY</a><div class="navbar-nav"><a class="nav-link" href="/Events">Events</a>@if(Context.Session.GetInt32("UserId")!=null){<a class="nav-link" href="/Events/Mine">My Enrolments</a><a class="nav-link" href="/Events/Results">My Results</a><span class="nav-link text-warning">@Context.Session.GetString("UserName")</span><a class="nav-link" href="/Account/Logout">Logout</a>}else{<a class="nav-link" href="/Account/Login">Login</a><a class="nav-link" href="/Account/Register">Register</a>}</div></div></nav><main class="container py-4">@if(TempData["Message"]!=null){<div class="alert alert-info">@TempData["Message"]</div>}@RenderBody()</main><footer class="text-center py-4 text-muted">RaceDay — South African running, walking and cycling events</footer></body></html>